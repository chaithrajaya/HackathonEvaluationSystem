						"value": "Bearer {{adminToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Summer Hackathon 2024\",\n  \"description\": \"Annual hackathon event with amazing prizes and learning opportunities for developers\",\n  \"startDate\": \"2024-06-01T09:00:00\",\n  \"endDate\": \"2024-06-03T18:00:00\",\n  \"createdByUserId\": 1\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/hackathons",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "hackathons"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Hackathon created successfully\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('hackathonId');",
							"    pm.expect(jsonData.name).to.eql('Summer Hackathon 2024');",
							"    pm.collectionVariables.set('hackathonId', jsonData.hackathonId);",
							"    console.log('Hackathon ID: ' + jsonData.hackathonId);",
							"});"
						]
					}
				}
			]
		},
